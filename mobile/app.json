{
  "expo": {
    "name": "Urbanize",
    "slug": "urbanize",
    "scheme": "urbanize",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.urbanize.app"
    },
    "android": {
      "package": "br.com.urbanize.app",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Urbanize usa sua localização para registrar o local exato da demanda."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Urbanize usa suas fotos para anexar evidências às demandas.",
          "cameraPermission": "O Urbanize usa a câmera para fotografar problemas urbanos."
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2b82d4"
        }
      ]
    ]
  }
}
