# URL base da API do backend Urbanize.
# - iOS Simulator / Web: http://127.0.0.1:4000/api
# - Android Emulator: http://10.0.2.2:4000/api
# - Dispositivo físico: http://<IP-da-sua-máquina-na-rede-local>:4000/api
#
# Só variáveis com prefixo EXPO_PUBLIC_ chegam ao app, e o valor é embutido no
# bundle: depois de editar, reinicie o Metro com `npx expo start --clear`.
EXPO_PUBLIC_API_URL="http://127.0.0.1:4000/api"
