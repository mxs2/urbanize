# MongoDB
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=urbanize
MONGO_INITDB_ROOT_PASSWORD=urbanize_secret
# Atlas: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local (Docker): mongodb://urbanize:urbanize_secret@localhost:27017/?authSource=admin
MONGODB_URI=mongodb://urbanize:urbanize_secret@localhost:27017/?authSource=admin

# Banco e coleção dos dados brutos
MONGODB_DB=urbanize_etl
MONGODB_RAW_COLLECTION=radar_recife_raw

# NeonDB (Postgres em nuvem)
DATABASE_URL=postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Agente do servidor MCP (mcp_server/agente.py)
OPENAI_API_KEY=sua-chave-aqui
# Modelo usado pelo agente (padrão: gpt-6-luna)
MODELO=gpt-6-luna
# Opcional: endereço de um serviço compatível com a biblioteca openai
# (deixe vazio para usar a OpenAI)
OPENAI_BASE_URL=
