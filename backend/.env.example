DATABASE_URL="file:./dev.db"

BACKEND_PORT=4000

# 0.0.0.0 aceita conexões da rede local (necessário para celular físico).
BACKEND_HOST=0.0.0.0

# Origens permitidas no CORS, separadas por vírgula. Só é aplicada em produção.
FRONTEND_URL="http://localhost:8081"

JWT_SECRET="troque-este-segredo"

JWT_EXPIRES_IN="15m"

AUTH_COOKIE_NAME="urbanize_session"

METRICS_CRON="*/15 * * * *"

# LGPD: meses até anonimizar o contato de demandas resolvidas/canceladas, e quando rodar.
RETENTION_MONTHS=12
RETENTION_CRON="0 3 * * *"

# Validade (segundos) dos links assinados de /uploads.
UPLOAD_URL_TTL_SECONDS=3600

# Só em produção (NODE_ENV=production): a API recusa requisições que não chegaram por HTTPS.
# TRUST_PROXY = saltos de proxy reverso confiáveis (1 para Caddy/Render). REQUIRE_HTTPS=false desliga.
# TRUST_PROXY=1
# REQUIRE_HTTPS=true
