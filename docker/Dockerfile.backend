FROM node:22-bookworm-slim

# better-sqlite3 é um módulo nativo e precisa de toolchain para compilar.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Camada de dependências separada do código para aproveitar o cache do Docker.
COPY backend/package.json backend/package-lock.json ./
RUN npm ci

COPY backend/ ./
RUN npx prisma generate

COPY docker/entrypoint-backend.sh /usr/local/bin/entrypoint-backend.sh
RUN chmod +x /usr/local/bin/entrypoint-backend.sh

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/entrypoint-backend.sh"]
CMD ["npm", "run", "dev"]
