FROM node:22-bookworm-slim

# As bibliotecas gráficas são exigidas pelo React Native DevTools (@react-native/debugger-shell),
# um app Electron que o Metro prepara ao subir. Sem elas o start falha com
# "error while loading shared libraries: libglib-2.0.so.0".
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    git openssl ca-certificates curl \
    libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
    libcups2 libdrm2 libgbm1 libgtk-3-0 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libpango-1.0-0 libcairo2 libasound2 libexpat1 \
  && rm -rf /var/lib/apt/lists/*

# O sandbox do Chromium depende de capabilities que o container não tem.
ENV ELECTRON_DISABLE_SANDBOX=1

WORKDIR /app

COPY mobile/package.json mobile/package-lock.json ./
RUN npm ci

COPY mobile/ ./

COPY docker/entrypoint-mobile.sh /usr/local/bin/entrypoint-mobile.sh
RUN chmod +x /usr/local/bin/entrypoint-mobile.sh

# 8081 = Metro (bundler web e do Expo Go), 19000/19001 = canais legados do Expo.
EXPOSE 8081 19000 19001

ENTRYPOINT ["/usr/local/bin/entrypoint-mobile.sh"]
# --lan imprime o QR code do Expo Go no log; a versão web continua sendo servida
# pelo mesmo Metro em http://localhost:8081.
# O binário local (e não `npx expo`) garante a CLI da SDK do projeto: o cache do
# npx pode guardar outra versão e servir um manifesto com a SDK errada.
CMD ["node_modules/.bin/expo", "start", "--lan", "--port", "8081"]
